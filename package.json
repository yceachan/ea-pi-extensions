{
  "name": "ea-pi-extensions",
  "version": "0.1.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gcm": "./gcm",
    "mono-sync": "bun scripts/mono-sync.mjs",
    "mono-release": "bun scripts/mono-release.mjs --help",
    "mono-release:patch": "bun scripts/mono-release.mjs patch",
    "mono-release:minor": "bun scripts/mono-release.mjs minor",
    "mono-release:major": "bun scripts/mono-release.mjs major",
    "version:check": "bun scripts/mono-sync.mjs --check",
    "version:sync": "bun scripts/mono-sync.mjs --sync",
    "typecheck": "bun run --filter '*' typecheck"
  }
}
