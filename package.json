{
  "name": "ea-pi-extensions",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gcm": "./gcm",
    "mono-tagcheck": "bun scripts/mono-tagcheck.mjs",
    "mono-release": "bun scripts/mono-release.mjs",
    "version:check": "bun scripts/mono-tagcheck.mjs --check",
    "version:sync": "bun scripts/mono-tagcheck.mjs --sync",
    "version:reset": "bun scripts/mono-tagcheck.mjs --reset",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run test:repo && bun run test:packages",
    "test:repo": "bun test scripts/tests/",
    "test:packages": "bun run --workspaces --sequential --no-exit-on-error --if-present test",
    "test:e2e": "bun run --workspaces --sequential --no-exit-on-error --if-present test:e2e",
    "gbump": "./gbump"
  },
  "private": true
}
